#!/bin/bash
#
# Run a command inside a node:24 container with this directory mounted, as the
# invoking user. The `signs` host's glibc/g++ are too old to load or build
# better-sqlite3's native module, so install/build/test all happen in here.
#
#   bin/dev yarn install
#   bin/dev yarn test
#   bin/dev yarn db:generate
#
set -e
cd "$(dirname "$0")/.."
TTY=()
[ -t 0 ] && [ -t 1 ] && TTY=(-it)
exec docker run --rm "${TTY[@]}" \
  --user "$(id -u):$(id -g)" \
  -e HOME=/tmp \
  -e TZ=America/Chicago \
  -v "$PWD":/app -w /app \
  node:24 "$@"
