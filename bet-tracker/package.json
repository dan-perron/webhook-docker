{
  "name": "bet-tracker",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "description": "Track open sportsbook bets with live, game-state-based win probability; web dashboard + MCP server",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "lint:check": "eslint .",
    "lint:fix": "eslint --fix .",
    "fix": "yarn lint:fix && yarn format:write",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "start": "node built/server.js",
    "dev": "yarn build && node built/server.js",
    "seed": "yarn build && node built/seed/cli.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "better-sqlite3": "^13.0.3",
    "config": "^5.0.1",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/config": "^4.4.0",
    "@types/node": "^24",
    "@typescript-eslint/eslint-plugin": "^6",
    "@typescript-eslint/parser": "^6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^8",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.9",
    "typescript": "^5",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
