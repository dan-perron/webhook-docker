{
  "compilerOptions": {
    "outDir": "./built",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "esnext",
    "strict": true,
    "verbatimModuleSyntax": true,
    "sourceMap": true,
    "inlineSourceMap": false,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx"
  },
  "include": ["./src/**/*"]
}
