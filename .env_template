MONGO_USERNAME=
MONGO_PASSWORD=
# calcium-tracker: leave CALCIUM_PASSWORD empty for open access, or set a shared
# password to gate the app. CALCIUM_COOKIE_SECRET signs the auth cookie.
CALCIUM_PASSWORD=
CALCIUM_COOKIE_SECRET=
# meeting-scheduler: no auth and no secrets — anyone with an event's random URL
# can answer it. Override the served path or database name only if you need to.
MEET_BASE_PATH=/meet
MEET_DATABASE=scheduler
# Leave true in production. Set false only to reach the app over plain http.
MEET_COOKIE_SECURE=true
# Absolute origin for shareable links (no trailing slash).
MEET_PUBLIC_ORIGIN=https://djperron.com
