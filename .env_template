MONGO_USERNAME=
MONGO_PASSWORD=
# calcium-tracker: leave CALCIUM_PASSWORD empty for open access, or set a shared
# password to gate the app. CALCIUM_COOKIE_SECRET signs the auth cookie.
CALCIUM_PASSWORD=
CALCIUM_COOKIE_SECRET=
# meeting-scheduler: no auth and no secrets — anyone with an event's random URL
# can answer it. Override the served path or database name only if you need to.
MEET_BASE_PATH=/meet
MEET_DATABASE=scheduler
# Leave true in production. Set false only to reach the app over plain http.
MEET_COOKIE_SECURE=true
# Absolute origin for shareable links (no trailing slash).
MEET_PUBLIC_ORIGIN=https://djperron.com
# bet-tracker: BET_APP_TOKEN is the bearer token for the API/MCP and the web
# login password (long random string). ODDS_API_KEY is from the-odds-api.com;
# leave empty to disable odds calls. BET_PREGAME_SNAPSHOT=false turns off the
# one automatic pregame odds snapshot per event.
BET_APP_TOKEN=
ODDS_API_KEY=
BET_PREGAME_SNAPSHOT=true
# bet-tracker Scores alerts: SCORES_NTFY_URL is the full ntfy topic URL
# (e.g. https://ntfy.sh/<long-random-topic>; the topic name is the secret).
# Empty = no push. SCORES_NTFY_TOKEN only for a protected topic.
# SCORES_QUIET_HOURS="23:00-08:00" (America/Chicago) logs alerts without pushing.
SCORES_NTFY_URL=
SCORES_NTFY_TOKEN=
SCORES_QUIET_HOURS=
